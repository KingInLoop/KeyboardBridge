{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "键盘输入桥",
  "version": "0.2.5",
  "identifier": "com.keyboardbridge.windows",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "键盘输入桥",
        "width": 720,
        "height": 590,
        "minWidth": 420,
        "minHeight": 500,
        "resizable": true,
        "maximizable": false,
        "alwaysOnTop": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}
