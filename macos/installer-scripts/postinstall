#!/bin/zsh
set -eu

target_volume="${3:-/}"
installed_app="$target_volume/Applications/KeyboardBridge.app"

if [[ ! -d "$installed_app" ]]; then
  echo "KeyboardBridge payload was not installed at: $installed_app" >&2
  exit 1
fi

if [[ "$target_volume" == "/" ]]; then
  launch_services='/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister'
  if [[ -x "$launch_services" ]]; then
    "$launch_services" -f "$installed_app" >/dev/null 2>&1 || true
  fi

  console_user=$(/usr/bin/stat -f '%Su' /dev/console 2>/dev/null || true)
  if [[ -n "$console_user" && "$console_user" != "root" && "$console_user" != "loginwindow" ]]; then
    console_uid=$(/usr/bin/id -u "$console_user")

    # An ad-hoc signature gets a new designated code identity whenever the app
    # is rebuilt. macOS can then leave an enabled-looking TCC row that belongs
    # to the previous binary. Reset only this bundle's two records before the
    # new app starts. Proper Developer ID builds have a stable TeamIdentifier
    # and retain their existing permissions across upgrades.
    team_id=$(/usr/bin/codesign -d --verbose=4 "$installed_app" 2>&1 \
      | /usr/bin/awk -F= '/^TeamIdentifier=/{print $2; exit}')
    if [[ -z "$team_id" || "$team_id" == "not set" ]]; then
      echo "Temporary signature detected; clearing stale KeyboardBridge privacy records."
      /bin/launchctl asuser "$console_uid" /usr/bin/sudo -u "$console_user" \
        /usr/bin/tccutil reset Accessibility local.keyboardbridge.app || true
      /bin/launchctl asuser "$console_uid" /usr/bin/sudo -u "$console_user" \
        /usr/bin/tccutil reset ListenEvent local.keyboardbridge.app || true
    fi

    /bin/launchctl asuser "$console_uid" /usr/bin/sudo -u "$console_user" /usr/bin/open "$installed_app" || true
  fi
fi

exit 0
